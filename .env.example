# ---------------------------------------------------------------------------
# TradeConnect environment
# Copy to .env.local and fill in from Supabase → Project Settings → API
# ---------------------------------------------------------------------------

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only — NEVER commit or expose. Used by scripts/seed.mjs.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: password used for every demo account created by the seed script
SEED_PASSWORD=Demo1234!
